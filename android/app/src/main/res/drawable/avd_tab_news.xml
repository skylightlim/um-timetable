<?xml version="1.0" encoding="utf-8"?>
<!-- The News tab's bell, chosen: it rings, swinging from its top with the clapper lagging. At rest it's ic_tab_news. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
            <group android:name="bell" android:pivotX="12" android:pivotY="4">
                <path android:pathData="M6,16.5V11a6,6 0 0,1 12,0v5.5l1.5,2h-15z" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8" android:strokeLineCap="round" android:strokeLineJoin="round" />
                <group android:name="clapper" android:pivotX="12" android:pivotY="18.5">
                    <path android:pathData="M10,20.5a2,2 0 0,0 4,0" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8" android:strokeLineCap="round" android:strokeLineJoin="round" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="bell"><aapt:attr name="android:animation">
        <objectAnimator android:duration="720"><propertyValuesHolder android:propertyName="rotation">
            <keyframe android:fraction="0" android:value="0" />
            <keyframe android:fraction="0.14" android:value="-16" />
            <keyframe android:fraction="0.34" android:value="14" />
            <keyframe android:fraction="0.54" android:value="-9" />
            <keyframe android:fraction="0.74" android:value="5" />
            <keyframe android:fraction="1" android:value="0" />
        </propertyValuesHolder></objectAnimator>
    </aapt:attr></target>
    <target android:name="clapper"><aapt:attr name="android:animation">
        <objectAnimator android:duration="720"><propertyValuesHolder android:propertyName="rotation">
            <keyframe android:fraction="0" android:value="0" />
            <keyframe android:fraction="0.2" android:value="12" />
            <keyframe android:fraction="0.4" android:value="-12" />
            <keyframe android:fraction="0.6" android:value="7" />
            <keyframe android:fraction="0.8" android:value="-3" />
            <keyframe android:fraction="1" android:value="0" />
        </propertyValuesHolder></objectAnimator>
    </aapt:attr></target>
</animated-vector>
