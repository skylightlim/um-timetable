<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings tab's three sliders, chosen: each row slides over and back, one after another. At rest it's ic_settings. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
            <group android:name="top">
                <path android:pathData="M21,4h-7M10,4H3M14,2v4" android:strokeColor="#FFFFFFFF" android:strokeWidth="2" android:strokeLineCap="round" android:strokeLineJoin="round" />
            </group>
            <group android:name="middle">
                <path android:pathData="M21,12h-9M8,12H3M8,10v4" android:strokeColor="#FFFFFFFF" android:strokeWidth="2" android:strokeLineCap="round" android:strokeLineJoin="round" />
            </group>
            <group android:name="bottom">
                <path android:pathData="M21,20h-5M12,20H3M16,18v4" android:strokeColor="#FFFFFFFF" android:strokeWidth="2" android:strokeLineCap="round" android:strokeLineJoin="round" />
            </group>
        </vector>
    </aapt:attr>
    <!-- Each row out by 2 and back, overshooting a little, 70 ms after the one above. -->
    <target android:name="top"><aapt:attr name="android:animation">
        <objectAnimator android:duration="360"><propertyValuesHolder android:propertyName="translateX">
            <keyframe android:fraction="0" android:value="0" /><keyframe android:fraction="0.4" android:value="-2" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <keyframe android:fraction="1" android:value="0" android:interpolator="@android:anim/overshoot_interpolator" />
        </propertyValuesHolder></objectAnimator>
    </aapt:attr></target>
    <target android:name="middle"><aapt:attr name="android:animation">
        <objectAnimator android:duration="360" android:startOffset="70"><propertyValuesHolder android:propertyName="translateX">
            <keyframe android:fraction="0" android:value="0" /><keyframe android:fraction="0.4" android:value="2" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <keyframe android:fraction="1" android:value="0" android:interpolator="@android:anim/overshoot_interpolator" />
        </propertyValuesHolder></objectAnimator>
    </aapt:attr></target>
    <target android:name="bottom"><aapt:attr name="android:animation">
        <objectAnimator android:duration="360" android:startOffset="140"><propertyValuesHolder android:propertyName="translateX">
            <keyframe android:fraction="0" android:value="0" /><keyframe android:fraction="0.4" android:value="-2" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <keyframe android:fraction="1" android:value="0" android:interpolator="@android:anim/overshoot_interpolator" />
        </propertyValuesHolder></objectAnimator>
    </aapt:attr></target>
</animated-vector>
