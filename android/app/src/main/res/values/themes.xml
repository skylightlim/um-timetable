<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UMTimetable" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:windowSplashScreenBackground">@color/app_ground</item>
    </style>

    <!-- A day's name over the widget's grid: a picture, centred and never scaled. -->
    <style name="GridHead">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2.5dp</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="GridCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2.5dp</item>
        <item name="android:background">@drawable/col</item>
    </style>
</resources>
